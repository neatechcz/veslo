{
  "name": "veslo-orchestrator",
  "version": "2026.7.1",
  "opencodeVersion": "1.17.13",
  "description": "Veslo host orchestrator for opencode + Veslo server + veslo-code-router",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "build:bin": "node scripts/clean-dist.mjs && bun --config=./script/bunfig.build.toml ./script/build.ts --outdir dist/bin --filename veslo",
    "build:bin:all": "node scripts/clean-dist.mjs && bun --config=./script/bunfig.build.toml ./script/build.ts --outdir dist/bin --filename veslo --target bun-darwin-arm64 --target bun-darwin-x64 --target bun-windows-x64-baseline",
    "build:bin:bundled": "node scripts/clean-dist.mjs && node ../desktop/scripts/prepare-sidecar.mjs --outdir dist && bun --config=./script/bunfig.build.toml ./script/build.ts --outdir dist --filename veslo && bun scripts/build-bin.ts",
    "build:sidecars": "node scripts/build-sidecars.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test:router": "pnpm build && node scripts/router.mjs",
    "test:files": "pnpm build && node scripts/files-session.mjs",
    "prepublishOnly": "node -e \"console.error('veslo-orchestrator is published via packages/orchestrator/scripts/publish-npm.mjs (meta + platform packages)'); process.exit(1);\""
  },
  "files": [
    "dist",
    "bin",
    "script",
    "scripts",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neatech/veslo.git",
    "directory": "packages/orchestrator"
  },
  "homepage": "https://github.com/neatech/veslo/tree/dev/packages/orchestrator",
  "bugs": {
    "url": "https://github.com/neatech/veslo/issues"
  },
  "keywords": [
    "veslo",
    "opencode",
    "orchestrator",
    "cli",
    "agent"
  ],
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.5",
    "@ai-sdk/provider": "4.0.2",
    "@ai-sdk/provider-utils": "5.0.5",
    "@anthropic-ai/sandbox-runtime": "0.0.52",
    "@opencode-ai/plugin": "1.17.13",
    "@opencode-ai/sdk": "1.17.13",
    "@opentui/core": "0.4.1",
    "@opentui/keymap": "0.4.1",
    "@opentui/solid": "0.4.1",
    "@standard-schema/spec": "1.1.0",
    "@workflow/serde": "4.1.0",
    "eventsource-parser": "3.1.0",
    "json-schema": "0.4.0",
    "solid-js": "1.9.12",
    "veslo-code-router": "2026.7.1",
    "veslo-server": "2026.7.1",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@opentui/core-darwin-arm64": "0.4.1",
    "@opentui/core-darwin-x64": "0.4.1",
    "@opentui/core-linux-arm64": "0.4.1",
    "@opentui/core-linux-x64": "0.4.1",
    "@opentui/core-win32-x64": "0.4.1",
    "@types/node": "^22.10.2",
    "bun-types": "^1.3.6",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@10.27.0"
}
