<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <Property Id="MsiLogging" Value="voicewarmupx!" />
    <!--
      WSL provisioning is kept as a dormant rollback path. Windows installer
      builds now start Veslo in shared non-sandbox mode, so the WSL custom
      action and launch suppression below stay disabled unless explicitly
      enabled by setting VESLO_ENABLE_WSL_INSTALLER=1.
    -->
    <Property Id="VESLO_ENABLE_WSL_INSTALLER" Value="0" />

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="VesloWslProvisioningInstallerAnchor" Guid="36d5c50b-0df9-45ac-a2ae-6f0032f108d4">
        <RegistryValue
          Root="HKCU"
          Key="Software\Neatech\Veslo"
          Name="WslProvisioningInstallerBridge"
          Type="integer"
          Value="1"
          KeyPath="yes" />
        <RemoveFile Id="RemoveOldVesloWslClientInstaller" Name="wsl2-client-installer.ps1" On="install" />
        <RemoveFile Id="RemoveOldVesloWslPrerequisiteInstaller" Name="wsl2-prerequisite-installer.ps1" On="install" />
        <RemoveFile Id="RemoveOldVesloWslSandboxInstaller" Name="wsl2-sandbox-installer.ps1" On="install" />
        <RemoveFile Id="RemoveOldVesloWslSandboxProvisioner" Name="windows-wsl2-sandbox-provision.ps1" On="install" />
      </Component>
    </DirectoryRef>

    <ComponentGroup Id="VesloWslProvisioningInstallerComponents">
      <ComponentRef Id="VesloWslProvisioningInstallerAnchor" />
    </ComponentGroup>

    <CustomAction
      Id="VesloProvisionWslSandbox"
      Directory="INSTALLDIR"
      Execute="deferred"
      Impersonate="no"
      Return="check"
      ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -File &quot;[INSTALLDIR]wsl2-client-installer.ps1&quot; -MachineSetupOnly -AllowDeferredRuntimeRepairSuccess" />

    <CustomAction
      Id="VesloDisableExitDialogLaunchCheckbox"
      Property="WIXUI_EXITDIALOGOPTIONALCHECKBOX"
      Value="0" />

    <CustomAction
      Id="VesloClearExitDialogLaunchCheckboxText"
      Property="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
      Value="" />

    <CustomAction
      Id="VesloDisableAutoLaunchApp"
      Property="AUTOLAUNCHAPP"
      Value="" />

    <InstallUISequence>
      <Custom Action="VesloDisableExitDialogLaunchCheckbox" Before="ExecuteAction"><![CDATA[VESLO_ENABLE_WSL_INSTALLER="1" AND NOT Installed]]></Custom>
      <Custom Action="VesloClearExitDialogLaunchCheckboxText" After="VesloDisableExitDialogLaunchCheckbox"><![CDATA[VESLO_ENABLE_WSL_INSTALLER="1" AND NOT Installed]]></Custom>
    </InstallUISequence>

    <InstallExecuteSequence>
      <Custom Action="VesloProvisionWslSandbox" After="InstallFiles"><![CDATA[VESLO_ENABLE_WSL_INSTALLER="1" AND NOT REMOVE~="ALL"]]></Custom>
      <Custom Action="VesloDisableAutoLaunchApp" Before="LaunchApplication"><![CDATA[VESLO_ENABLE_WSL_INSTALLER="1" AND AUTOLAUNCHAPP AND NOT Installed]]></Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>
