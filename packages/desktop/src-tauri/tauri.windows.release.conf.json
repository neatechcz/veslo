{
  "bundle": {
    "resources": {
      "../package.json": "package.json",
      "sidecars/chrome-devtools-mcp-package": "chrome-devtools-mcp-package"
    },
    "windows": {
      "signCommand": {
        "cmd": "pwsh",
        "args": [
          "-NoProfile",
          "-NonInteractive",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "../../../scripts/release/windows-sign.ps1",
          "%1"
        ]
      }
    }
  }
}
