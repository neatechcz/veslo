{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veslo by Neatech",
  "version": "2026.6.20",
  "identifier": "com.neatech.veslo",
  "build": {
    "beforeDevCommand": "node ./scripts/tauri-before-dev.mjs",
    "beforeBuildCommand": "pnpm -C ../.. --filter @neatech/veslo run prepare:sidecar && pnpm -w build:ui",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Veslo by Neatech",
        "create": false,
        "width": 1180,
        "minWidth": 390,
        "height": 820,
        "resizable": true,
        "devtools": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "macOS": {
      "entitlements": "./entitlements.plist",
      "infoPlist": "./macos-info.plist"
    },
    "windows": {
      "wix": {
        "upgradeCode": "d7c34db0-c7b1-5844-91a5-7beada0715b0",
        "version": "26.6.20",
        "language": {
          "cs-CZ": {
            "localePath": "windows/locales/cs-CZ.wxl"
          }
        },
        "fragmentPaths": [
          "windows/wsl2-sandbox-installer.wxs"
        ],
        "componentGroupRefs": [
          "VesloWslProvisioningInstallerComponents"
        ]
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Czech",
          "English"
        ],
        "customLanguageFiles": {
          "Czech": "windows/locales/Czech.nsh"
        },
        "installerHooks": "windows/nsis-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "sidecars/veslo-code",
      "sidecars/opencode",
      "sidecars/veslo-server",
      "sidecars/veslo-code-router",
      "sidecars/veslo-orchestrator",
      "sidecars/chrome-devtools-mcp",
      "sidecars/versions.json",
      "sidecars/opencode-managed-deps.json"
    ],
    "resources": {
      "../package.json": "package.json",
      "../../orchestrator/scripts/windows-wsl2-sandbox-provision.ps1": "windows-wsl2-sandbox-provision.ps1",
      "windows/wsl2-prerequisite-installer.ps1": "wsl2-prerequisite-installer.ps1",
      "windows/wsl2-client-installer.ps1": "wsl2-client-installer.ps1",
      "windows/wsl2-sandbox-installer.ps1": "wsl2-sandbox-installer.ps1"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "veslo"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2N0QxRkVDNzU0RTk4NDEKUldSQm1FNTE3Qjk5dGprZ3NRM2dzUkF0SURCTDFxTmgvdHhIZE9nN1VMbi8wS2pxRHpNWkJoL2IK",
      "endpoints": [
        "https://github.com/neatechcz/veslo-updates/releases/latest/download/latest.json"
      ],
      "windows": {
        "installerArgs": [
          "/l*v",
          "C:\\ProgramData\\veslo-updater-msi.log"
        ]
      }
    }
  }
}
