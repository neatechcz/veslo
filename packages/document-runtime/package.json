{
  "name": "veslo-document-runtime",
  "version": "2026.7.0",
  "private": true,
  "description": "Veslo document runtime package manifest and updater feed contract",
  "type": "module",
  "bin": {
    "veslo-document-runtime": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "scripts": {
    "test": "node --test src/**/*.test.mjs",
    "typecheck": "node scripts/syntax-check.mjs",
    "validate:manifest": "node ../../scripts/document-runtime/validate-manifest.mjs",
    "validate:package-feed": "node ../../scripts/document-runtime/validate-package-feed.mjs",
    "check:licenses": "node ../../scripts/document-runtime/check-licenses.mjs"
  },
  "files": [
    "src",
    "manifests",
    "README.md"
  ],
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.27.0"
}
