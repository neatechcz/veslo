{
  "name": "veslo-server",
  "version": "2026.7.4",
  "description": "Filesystem-backed API for Veslo remote clients",
  "type": "module",
  "bin": {
    "veslo-server": "dist/bin/veslo-server"
  },
  "scripts": {
    "dev": "bun src/cli.ts",
    "test": "bun test src",
    "test:wsl-bridge-live": "node script/wsl-bridge-live-test.mjs",
    "build": "tsc -p tsconfig.json",
    "build:bin": "bun build --compile src/cli.ts --outfile dist/bin/veslo-server",
    "typecheck:skills-strict": "node script/typecheck-skills-strict.mjs",
    "build:bin:all": "bun ./script/build.ts --outdir dist/bin --target bun-darwin-arm64 --target bun-darwin-x64 --target bun-windows-x64-baseline",
    "start": "bun dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build:bin"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neatech/veslo.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/neatech/veslo/tree/dev/packages/server",
  "bugs": {
    "url": "https://github.com/neatech/veslo/issues"
  },
  "keywords": [
    "veslo",
    "server",
    "opencode",
    "headless",
    "cli"
  ],
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "cron-parser": "^5.5.0",
    "jsonc-parser": "^3.2.1",
    "minimatch": "^10.0.1",
    "yaml": "^2.6.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/minimatch": "^5.1.2",
    "@types/node": "^22.10.2",
    "bun-types": "^1.3.6",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@10.27.0"
}
