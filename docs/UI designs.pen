                  "name": "orgTextB",
                  "fill": "#111827",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Keep roles simple: member creates and submits; owner approves org sharing; platform_admin handles platform-wide approval and emergency overrides.",
