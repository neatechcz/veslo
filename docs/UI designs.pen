    {
      "type": "frame",
      "id": "qQk3r",
      "x": 6920,
      "y": 1660,
      "name": "Extension Registry Pitfalls Deep Dive",
      "width": 3300,
      "height": 2500,
      "fill": "#FFFDF8",
      "cornerRadius": 20,
      "stroke": {
        "thickness": 1,
        "fill": "#F2D9B5"
      },
      "layout": "vertical",
      "gap": 28,
      "padding": 44,
      "children": [
        {
          "type": "frame",
          "id": "y5cxwc",
          "name": "Header",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 10,
          "children": [
            {
              "type": "text",
              "id": "n9pz8F",
              "name": "pitTitle",
              "fill": "#111827",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Pitfalls Deep Dive",
              "lineHeight": 1.1,
              "fontFamily": "Inter",
              "fontSize": 42,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "b0TuW",
              "name": "pitSub",
              "fill": "#4B5563",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Failure modes that must be designed into the registry, org governance, runtime installation and UI before implementation.",
              "lineHeight": 1.35,
              "fontFamily": "Inter",
              "fontSize": 18,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "r0Zpq",
          "name": "Pitfalls Row 1",
          "width": "fill_container",
          "height": 420,
          "gap": 20,
          "children": [
            {
              "type": "frame",
              "id": "H4T4Z",
              "name": "Secrets and OAuth leakage",
              "width": "fill_container",
              "height": "fill_container",
              "fill": "#FFFFFF",
              "cornerRadius": 14,
              "stroke": {
                "thickness": 1,
                "fill": "#F3C99D"
              },
              "layout": "vertical",
              "gap": 12,
              "padding": 22,
              "children": [
                {
                  "type": "text",
                  "id": "P5bVu",
                  "name": "secTitle",
                  "fill": "#111827",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "1. Secrets and OAuth leakage",
                  "lineHeight": 1.15,
                  "fontFamily": "Inter",
                  "fontSize": 21,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "DYbML",
                  "name": "secBody",
                  "fill": "#374151",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Problem: MCP catalog entries can accidentally include OAuth client secrets, bearer tokens, tenant-specific URLs or local auth-store paths. A platform item copied from one org could leak credentials to every org.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "bxBIY",
                  "name": "secControls",
                  "fill": "#92400E",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Controls: manifest stores only required secret names and auth method; tokens live in OS keychain or Den secret store; publish review redacts config; remote MCP OAuth registrations are per org unless explicitly platform-owned.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "pgWkw",
              "name": "Local runtime assumptions",
              "width": "fill_container",
              "height": "fill_container",
              "fill": "#FFFFFF",
              "cornerRadius": 14,
              "stroke": {
                "thickness": 1,
                "fill": "#F3C99D"
              },
              "layout": "vertical",
              "gap": 12,
              "padding": 22,
              "children": [
                {
                  "type": "text",
                  "id": "gWk2n",
                  "name": "locTitle",
                  "fill": "#111827",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "2. Local runtime assumptions",
                  "lineHeight": 1.15,
                  "fontFamily": "Inter",
                  "fontSize": 21,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "PnmMi",
                  "name": "locBody",
                  "fill": "#374151",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Problem: local MCP commands and plugins may depend on macOS paths, shell profile PATH, installed binaries, private folders or architecture-specific packages. They work for the author and fail everywhere else.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "bjqAX",
                  "name": "locControls",
                  "fill": "#92400E",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Controls: declare runtime requirements, supported OS, binary probes and setup commands; distinguish remote MCP, local MCP and hosted service; show installability per device/workspace before enabling.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "J8HdYI",
              "name": "Version drift and pinning",
              "width": "fill_container",
              "height": "fill_container",
              "fill": "#FFFFFF",
              "cornerRadius": 14,
              "stroke": {
                "thickness": 1,
                "fill": "#F3C99D"
              },
              "layout": "vertical",
              "gap": 12,
              "padding": 22,
              "children": [
                {
                  "type": "text",
                  "id": "zq1Zp",
                  "name": "verTitle",
                  "fill": "#111827",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "3. Version drift and pinning",
                  "lineHeight": 1.15,
                  "fontFamily": "Inter",
                  "fontSize": 21,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "seZsW",
                  "name": "verBody",
                  "fill": "#374151",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Problem: platform publishes v3, org approves v2, user installed v1, workspace pins a fork. Without explicit precedence, the UI cannot explain what will run.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "rNCR9",
                  "name": "verControls",
                  "fill": "#92400E",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Controls: immutable releases, semantic version metadata, effective-state resolver, visible pin/override badges, migration notes, and update channels: manual, recommended, required, blocked.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "wL89S",
          "name": "Pitfalls Row 2",
          "width": "fill_container",
          "height": 420,
          "gap": 20,
          "children": [
            {
              "type": "frame",
              "id": "qq4m7",
              "name": "Name shadowing and precedence",
              "width": "fill_container",
              "height": "fill_container",
              "fill": "#FFFFFF",
              "cornerRadius": 14,
              "stroke": {
                "thickness": 1,
                "fill": "#F3C99D"
              },
              "layout": "vertical",
              "gap": 12,
              "padding": 22,
              "children": [
                {
                  "type": "text",
                  "id": "O1wYcb",
                  "name": "shaTitle",
                  "fill": "#111827",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "4. Name shadowing and precedence",
                  "lineHeight": 1.15,
                  "fontFamily": "Inter",
                  "fontSize": 21,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "k9eHb",
                  "name": "shaBody",
                  "fill": "#374151",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Problem: same extension name exists in workspace, user, org and platform scopes. A malicious local item can impersonate an approved org/platform package.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "w7EWFo",
                  "name": "shaControls",
                  "fill": "#92400E",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Controls: stable package IDs separate from display names; show source and trust tier; resolver never matches by name alone; workspace override is explicit and auditable; collision warnings are blocking for platform/org names.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "omklN",
              "name": "Revocation and stale installs",
              "width": "fill_container",
              "height": "fill_container",
              "fill": "#FFFFFF",
              "cornerRadius": 14,
              "stroke": {
                "thickness": 1,
                "fill": "#F3C99D"
              },
              "layout": "vertical",
              "gap": 12,
              "padding": 22,
              "children": [
                {
                  "type": "text",
                  "id": "knqUR",
                  "name": "revTitle",
                  "fill": "#111827",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "5. Revocation and stale installs",
                  "lineHeight": 1.15,
                  "fontFamily": "Inter",
                  "fontSize": 21,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "YvDqh",
                  "name": "revBody",
                  "fill": "#374151",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Problem: removed or compromised releases can remain copied into old workspaces. A user may keep running a package that the org or platform has revoked.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "REPCN",
                  "name": "revControls",
                  "fill": "#92400E",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Controls: global deny/quarantine list, install records checked at runtime, explicit disabled reason, stale local file detection, cleanup action, emergency revoke path and offline grace policy.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "V3mXyJ",
              "name": "Reload timing",
              "width": "fill_container",
              "height": "fill_container",
              "fill": "#FFFFFF",
              "cornerRadius": 14,
              "stroke": {
                "thickness": 1,
                "fill": "#F3C99D"
              },
              "layout": "vertical",
              "gap": 12,
              "padding": 22,
              "children": [
                {
                  "type": "text",
                  "id": "oTcS8",
                  "name": "relTitle",
                  "fill": "#111827",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "6. Reload timing and active sessions",
                  "lineHeight": 1.15,
                  "fontFamily": "Inter",
                  "fontSize": 21,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "tpGor",
                  "name": "relBody",
                  "fill": "#374151",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Problem: Skills, plugins and MCP are startup-time runtime inputs. Changing them while a session runs can interrupt work or make UI state disagree with OpenCode state.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "CkWa6",
                  "name": "relControls",
                  "fill": "#92400E",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Controls: separate save/install from activate; per-workspace reload queue; idle-only auto-reload; resume-after-reload rules; visible pending activation state; never silently reload active work.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "C1zi2P",
          "name": "Pitfalls Row 3",
          "width": "fill_container",
          "height": 420,
          "gap": 20,
          "children": [
            {
              "type": "frame",
              "id": "Uaf2o",
              "name": "Audit and accountability",
              "width": "fill_container",
              "height": "fill_container",
              "fill": "#FFFFFF",
              "cornerRadius": 14,
              "stroke": {
                "thickness": 1,
                "fill": "#F3C99D"
              },
              "layout": "vertical",
              "gap": 12,
              "padding": 22,
              "children": [
                {
                  "type": "text",
                  "id": "xtxny",
                  "name": "audTitle",
                  "fill": "#111827",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "7. Audit and accountability gaps",
                  "lineHeight": 1.15,
                  "fontFamily": "Inter",
                  "fontSize": 21,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "zswHv",
                  "name": "audBody",
                  "fill": "#374151",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Problem: when an extension reaches org or platform scope, it affects many users. If approval, update, revoke and install actions are not attributed, incidents cannot be reconstructed.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "TzhqN",
                  "name": "audControls",
                  "fill": "#92400E",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Controls: audit every publish request, review decision, release, install, enable, disable, pin, override and revoke. Keep actor, scope, org, release hash, reason and before/after diff.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "gvf7V",
              "name": "Org identity ambiguity",
              "width": "fill_container",
              "height": "fill_container",
              "fill": "#FFFFFF",
              "cornerRadius": 14,
              "stroke": {
                "thickness": 1,
                "fill": "#F3C99D"
              },
              "layout": "vertical",
              "gap": 12,
              "padding": 22,
              "children": [
                {
                  "type": "text",
                  "id": "AOUzq",
                  "name": "orgAmbTitle",
                  "fill": "#111827",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "8. Active org ambiguity",
                  "lineHeight": 1.15,
                  "fontFamily": "Inter",
                  "fontSize": 21,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "FzXy5",
                  "name": "orgAmbBody",
                  "fill": "#374151",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Problem: users can belong to several orgs, while local workspaces are on one device. Catalog visibility and sharing target can be wrong if active org is only an implicit UI choice.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "p6meZ3",
                  "name": "orgAmbControls",
                  "fill": "#92400E",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Controls: every cloud catalog call carries explicit org ID; publishing modals show target org; workspace can remember last org association; personal org is clearly labeled and not treated as company org.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "Ozq11",
              "name": "Effective policy complexity",
              "width": "fill_container",
              "height": "fill_container",
              "fill": "#FFFFFF",
              "cornerRadius": 14,
              "stroke": {
                "thickness": 1,
                "fill": "#F3C99D"
              },
              "layout": "vertical",
              "gap": 12,
              "padding": 22,
              "children": [
                {
                  "type": "text",
                  "id": "kaVji",
                  "name": "polTitle",
                  "fill": "#111827",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "9. Effective policy complexity",
                  "lineHeight": 1.15,
                  "fontFamily": "Inter",
                  "fontSize": 21,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "OZclH",
                  "name": "polBody",
                  "fill": "#374151",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Problem: platform may require/block, org may default/block, user may disable, workspace may pin. Without one resolver, each page will compute different truth.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "oBp10",
                  "name": "polControls",
                  "fill": "#92400E",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Controls: central effective-state endpoint returns available, installed, enabled, blocked, required, updateAvailable and reason chain. UI renders the reason chain instead of re-deriving policy.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "gVU3k",
          "name": "Pitfalls Row 4",
          "width": "fill_container",
          "height": 420,
          "gap": 20,
          "children": [
            {
              "type": "frame",
              "id": "YiR4y",
              "name": "Skill prompt hazards",
              "width": "fill_container",
              "height": "fill_container",
              "fill": "#FFFFFF",
              "cornerRadius": 14,
              "stroke": {
                "thickness": 1,
                "fill": "#F3C99D"
              },
              "layout": "vertical",
              "gap": 12,
              "padding": 22,
              "children": [
                {
                  "type": "text",
                  "id": "kfLBy",
                  "name": "skillTitle",
                  "fill": "#111827",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "10. Skill prompt hazards",
                  "lineHeight": 1.15,
                  "fontFamily": "Inter",
                  "fontSize": 21,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "d1gQ8",
                  "name": "skillBody",
                  "fill": "#374151",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Problem: a skill is prompt/control text. It can smuggle hidden instructions, disable expected behavior, over-broaden file access or teach unsafe workflows without looking like code.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "VbH6w",
                  "name": "skillControls",
                  "fill": "#92400E",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Controls: review rendered skill content, frontmatter, aliases, user-invocable flags and paths. Show what triggers it, what it asks the agent to do and whether it changes model/tool behavior.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "bDJre",
              "name": "MCP trust boundary",
              "width": "fill_container",
              "height": "fill_container",
              "fill": "#FFFFFF",
              "cornerRadius": 14,
              "stroke": {
                "thickness": 1,
                "fill": "#F3C99D"
              },
              "layout": "vertical",
              "gap": 12,
              "padding": 22,
              "children": [
                {
                  "type": "text",
                  "id": "JgJz5",
                  "name": "mcpTitle",
                  "fill": "#111827",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "11. MCP trust boundary",
                  "lineHeight": 1.15,
                  "fontFamily": "Inter",
                  "fontSize": 21,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "BJQmX",
                  "name": "mcpBody",
                  "fill": "#374151",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Problem: remote MCPs expose third-party capabilities; local MCPs execute commands. OAuth consent, tool list, network target and local command surface are all security boundaries.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "xVpVJ",
                  "name": "mcpControls",
                  "fill": "#92400E",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Controls: validate URLs, separate remote/local install flows, show tool inventory, OAuth owner, scopes and callback type. Local MCP commands require device readiness checks and explicit activation.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "s8S89",
              "name": "Plugin code execution",
              "width": "fill_container",
              "height": "fill_container",
              "fill": "#FFFFFF",
              "cornerRadius": 14,
              "stroke": {
                "thickness": 1,
                "fill": "#F3C99D"
              },
              "layout": "vertical",
              "gap": 12,
              "padding": 22,
              "children": [
                {
                  "type": "text",
                  "id": "LXnQK",
                  "name": "plugTitle",
                  "fill": "#111827",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "12. Plugin code execution",
                  "lineHeight": 1.15,
                  "fontFamily": "Inter",
                  "fontSize": 21,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "ggFAG",
                  "name": "plugBody",
                  "fill": "#374151",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Problem: plugins are executable code and can add tools. A platform plugin is much higher risk than a skill because review must consider code, dependencies and runtime permissions.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "KxLub",
                  "name": "plugControls",
                  "fill": "#92400E",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Controls: package signing, source URL, dependency lock, static checks, permission manifest, sandbox expectations, update review and emergency quarantine. Plugin review is never only metadata review.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "Mg6vY",
          "name": "Pitfalls Row 5",
          "width": "fill_container",
          "height": 420,
          "gap": 20,
          "children": [
            {
              "type": "frame",
              "id": "m3OqAy",
              "name": "Offline and cache behavior",
              "width": "fill_container",
              "height": "fill_container",
              "fill": "#FFFFFF",
              "cornerRadius": 14,
              "stroke": {
                "thickness": 1,
                "fill": "#F3C99D"
              },
              "layout": "vertical",
              "gap": 12,
              "padding": 22,
              "children": [
                {
                  "type": "text",
                  "id": "Ud4yb",
                  "name": "offTitle",
                  "fill": "#111827",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "13. Offline and cache behavior",
                  "lineHeight": 1.15,
                  "fontFamily": "Inter",
                  "fontSize": 21,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "iFYoP",
                  "name": "offBody",
                  "fill": "#374151",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Problem: Veslo is local-first. Users can be offline while platform/org policy changed. A cached catalog may claim an extension is allowed when the cloud has revoked it.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "vDPyo",
                  "name": "offControls",
                  "fill": "#92400E",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Controls: cache TTL, last-policy-check timestamp, offline grace categories, mandatory online check for new install, and local denylist snapshot synced with the desktop runtime.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "g9vQGW",
              "name": "User meaning and labels",
              "width": "fill_container",
              "height": "fill_container",
              "fill": "#FFFFFF",
              "cornerRadius": 14,
              "stroke": {
                "thickness": 1,
                "fill": "#F3C99D"
              },
              "layout": "vertical",
              "gap": 12,
              "padding": 22,
              "children": [
                {
                  "type": "text",
                  "id": "X6KjA1",
                  "name": "uxTitle",
                  "fill": "#111827",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "14. User meaning and labels",
                  "lineHeight": 1.15,
                  "fontFamily": "Inter",
                  "fontSize": 21,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "JLqcW",
                  "name": "uxBody",
                  "fill": "#374151",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Problem: install, enable, activate, share, publish, approve and pin are different actions. If the UI compresses them into one Add button, users will misunderstand scope and blast radius.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "w2PHrz",
                  "name": "uxControls",
                  "fill": "#92400E",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Controls: action labels include target scope; detail page shows effective state and next required step; publishing flows are separate from local installation; dangerous scope changes require confirmation.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "LkzU9",
              "name": "Review quality gates",
              "width": "fill_container",
              "height": "fill_container",
              "fill": "#FFFFFF",
              "cornerRadius": 14,
              "stroke": {
                "thickness": 1,
                "fill": "#F3C99D"
              },
              "layout": "vertical",
              "gap": 12,
              "padding": 22,
              "children": [
                {
                  "type": "text",
                  "id": "Mi0GR",
                  "name": "revqTitle",
                  "fill": "#111827",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "15. Review quality gates",
                  "lineHeight": 1.15,
                  "fontFamily": "Inter",
                  "fontSize": 21,
                  "fontWeight": "700"
                },
                {
                  "type": "text",
                  "id": "qOWjB",
                  "name": "revqBody",
                  "fill": "#374151",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Problem: platform-wide approval cannot be a binary approve/reject button. Different extension types need different evidence before trust is reasonable.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "t8YNp",
                  "name": "revqControls",
                  "fill": "#92400E",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Controls: required manifest, screenshots/docs, permissions, runtime probes, source provenance, maintainer identity, support owner, changelog and rollback plan before platform release.",
                  "lineHeight": 1.38,
                  "fontFamily": "Inter",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        }
      ]
    },
