{
  "name": "@neatech/ai-gateway",
  "private": true,
  "type": "module",
  "exports": {
    "./test-support": "./src/test-support.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "tsx --test test/**/*.test.ts",
    "test:node22-smoke": "node test/node22-openai-compatible-smoke.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "ops:codex-model-migration": "node dist/ops/migrate-codex-model.js",
    "ops:codex-credential-probe": "node dist/ops/probe-codex-credentials.js"
  },
  "dependencies": {
    "@openai/codex": "0.144.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.1",
    "express": "^4.19.2",
    "mysql2": "^3.11.3",
    "undici": "5.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.15.7",
    "typescript": "^5.5.4"
  }
}
