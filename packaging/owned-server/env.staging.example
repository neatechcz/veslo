# Copy to /srv/veslo/env/staging.env on the staging owned server.
# Keep secrets out of git. Staging uses the VPN2-only server at 62.109.146.56
# and the staging.veslo.work hostname family.

# Reverse proxy and TLS
ACME_EMAIL=ops@veslo.work
VESLO_CADDYFILE=./Caddyfile.staging

# Host paths
BACKUP_HOST_ROOT=/srv/veslo/staging/backups

# MySQL container bootstrap values
DEN_DB_NAME=den
DEN_DB_USER=den
DEN_DB_PASSWORD=replace_with_staging_den_db_password
DEN_DB_ROOT_PASSWORD=replace_with_staging_den_root_password
AI_GATEWAY_DB_NAME=veslo_ai_gateway
AI_GATEWAY_DB_USER=gateway
AI_GATEWAY_DB_PASSWORD=replace_with_staging_ai_gateway_db_password
AI_GATEWAY_DB_ROOT_PASSWORD=replace_with_staging_ai_gateway_root_password

# Den
DATABASE_URL=mysql://den:replace_with_staging_den_db_password@den-db:3306/den
BETTER_AUTH_SECRET=replace_with_staging_32_char_den_auth_secret
BETTER_AUTH_URL=https://api.staging.veslo.work
WORKER_TOKEN_ENCRYPTION_KEY=replace_with_staging_worker_token_encryption_key
GITHUB_CLIENT_ID=replace_with_staging_github_client_id
GITHUB_CLIENT_SECRET=replace_with_staging_github_client_secret
LETTR_API_KEY=replace_with_lettr_api_key
AUTH_EMAIL_ADDRESS=auth@veslo.work
AUTH_EMAIL_FROM_NAME=Veslo Staging
BACKUP_ALERT_EMAIL_RECIPIENTS=
BACKUP_DAILY_UTC_TIME=02:15:00
BACKUP_RANDOM_DELAY_SECONDS=900
DEN_AI_GATEWAY_INTERNAL_TOKEN=replace_with_staging_shared_den_ai_gateway_internal_token
CORS_ORIGINS=https://app.staging.veslo.work,https://ai.staging.veslo.work,https://admin.staging.veslo.work
DESKTOP_AUTH_REQUIRE_EMAIL_VERIFIED=true
PROVISIONER_MODE=owned-server
WORKER_URL_TEMPLATE=
OWNED_WORKER_MANAGER_URL=http://worker-manager:8790
OWNED_WORKER_MANAGER_TOKEN=replace_with_staging_owned_worker_manager_token
OWNED_WORKER_PUBLIC_DOMAIN_SUFFIX=workers.staging.veslo.work

# Owned-server worker manager and runtime image
VESLO_DOCKER_NETWORK=veslo-staging-server-runtime
WORKER_IMAGE=veslo-staging-worker-runtime:local
WORKER_BUN_VERSION=1.3.6
WORKER_PROVISION_TIMEOUT_MS=180000
WORKER_POLL_INTERVAL_MS=2000
WORKER_HEALTHCHECK_TIMEOUT_MS=2000
WORKER_RESOURCE_MEMORY_BYTES=1073741824
WORKER_RESOURCE_CPUS=1

# Render values are retained only as rollback placeholders.
RENDER_API_BASE=https://api.render.com/v1
RENDER_API_KEY=
RENDER_OWNER_ID=
RENDER_WORKER_REPO=https://github.com/neatechcz/veslo
RENDER_WORKER_BRANCH=dev
RENDER_WORKER_ROOT_DIR=services/den-worker-runtime
RENDER_WORKER_PLAN=standard
RENDER_WORKER_REGION=oregon
RENDER_WORKER_VESLO_VERSION=0.11.113
RENDER_WORKER_NAME_PREFIX=den-worker-veslo-staging
RENDER_WORKER_PUBLIC_DOMAIN_SUFFIX=
RENDER_CUSTOM_DOMAIN_READY_TIMEOUT_MS=240000
RENDER_PROVISION_TIMEOUT_MS=900000
RENDER_HEALTHCHECK_TIMEOUT_MS=180000
RENDER_POLL_INTERVAL_MS=5000

# Temporary Vercel DNS integration for worker vanity domains
VERCEL_API_BASE=https://api.vercel.com
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_TEAM_SLUG=
VERCEL_DNS_DOMAIN=

# Polar paywall
POLAR_FEATURE_GATE_ENABLED=false
POLAR_API_BASE=https://api.polar.sh
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
POLAR_BENEFIT_ID=
POLAR_SUCCESS_URL=
POLAR_RETURN_URL=

# YouTrack feedback projection
YOUTRACK_PROJECT_KEY=VSLO
YOUTRACK_URL=
YOUTRACK_TOKEN=
YOUTRACK_TIMEOUT_MS=20000

# Den debug-log ingest
DEN_LOG_INGEST_TOKEN=
DEN_LOG_MASTER_KEY=
DEN_LOG_MASTER_KEY_VERSION=
DEN_LOG_RETENTION_DAYS=30

# Google Workspace connectors
# Redirect URI must match the Google Cloud OAuth web client exactly.
GOOGLE_WORKSPACE_OAUTH_CLIENT_ID=
GOOGLE_WORKSPACE_OAUTH_CLIENT_SECRET=
GOOGLE_WORKSPACE_OAUTH_REDIRECT_URI=https://api.staging.veslo.work/v1/integrations/google/oauth/callback
GOOGLE_WORKSPACE_OAUTH_STATE_SECRET=
GOOGLE_WORKSPACE_OAUTH_SUCCESS_REDIRECT_URL=https://app.staging.veslo.work/settings/integrations/google
GOOGLE_WORKSPACE_TOKEN_SECRET_KEY=
GOOGLE_WORKSPACE_CONNECTOR_BASE_URL=https://api.staging.veslo.work

# Microsoft connectors
# Redirect URI must match the Microsoft Entra app registration exactly.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://api.staging.veslo.work/v1/integrations/microsoft/oauth/callback
MICROSOFT_TOKEN_SECRET_KEY=
MICROSOFT_CONNECTOR_BASE_URL=https://api.staging.veslo.work

# Den-managed AI runtime, if Den owns managed-AI policy/assignment paths
MANAGED_AI_DATABASE_URL=
MANAGED_AI_SECRET_KEY=
MANAGED_AI_OPENAI_CLIENT_ID=
MANAGED_AI_OPENAI_CLIENT_SECRET=
MANAGED_AI_OPENAI_REDIRECT_BASE=https://ai.staging.veslo.work/auth/openai
MANAGED_AI_CODEX_COMMAND=codex
MANAGED_AI_CODEX_HOME=/var/lib/veslo-den/codex
MANAGED_AI_CODEX_ALLOW_HOST_HOME=
MANAGED_AI_CODEX_WORKDIR=/tmp
MANAGED_AI_CODEX_TIMEOUT_MS=180000
MANAGED_AI_CODEX_STATUS_TTL_MS=300000
MANAGED_AI_CODEX_AUTH_JSON=
MANAGED_AI_CODEX_OAUTH_INFERENCE_BASE_URL=
MANAGED_AI_CODEX_OAUTH_BASE_URL=

# Standalone AI Gateway
AI_GATEWAY_DATABASE_URL=mysql://gateway:replace_with_staging_ai_gateway_db_password@ai-gateway-db:3306/veslo_ai_gateway
AI_GATEWAY_SECRET_KEY=replace_with_staging_32_char_ai_gateway_secret
AI_GATEWAY_OPENAI_CLIENT_ID=replace_with_staging_openai_client_id
AI_GATEWAY_OPENAI_CLIENT_SECRET=replace_with_staging_openai_client_secret
AI_GATEWAY_OPENAI_REDIRECT_BASE=https://ai.staging.veslo.work/auth/openai
AI_GATEWAY_DEN_API_BASE=https://api.staging.veslo.work
AI_GATEWAY_DEN_INTERNAL_TOKEN=replace_with_staging_shared_den_ai_gateway_internal_token
AI_GATEWAY_ALERT_EMAIL_RECIPIENTS=
AI_GATEWAY_CODEX_CAPACITY_ALERT_EMAIL_INTERVAL_MS=300000
AI_GATEWAY_CREDENTIAL_ALERT_EMAIL_INTERVAL_MS=60000
AI_GATEWAY_CODEX_COMMAND=codex
AI_GATEWAY_CODEX_HOME=/var/lib/veslo-ai-gateway/codex
AI_GATEWAY_CODEX_ALLOW_HOST_HOME=
AI_GATEWAY_CODEX_WORKDIR=/tmp
AI_GATEWAY_CODEX_TIMEOUT_MS=180000
AI_GATEWAY_CODEX_STATUS_TTL_MS=300000
AI_GATEWAY_CODEX_AUTH_JSON=
AI_GATEWAY_CODEX_OAUTH_INFERENCE_BASE_URL=
AI_GATEWAY_CODEX_OAUTH_BASE_URL=

# Web app
# NEXT_PUBLIC_* values are baked into the web image during build.
DEN_API_BASE=https://api.staging.veslo.work
DEN_AUTH_ORIGIN=https://api.staging.veslo.work
NEXT_PUBLIC_OPENWORK_APP_CONNECT_URL=
NEXT_PUBLIC_OPENWORK_AUTH_CALLBACK_URL=https://app.staging.veslo.work
NEXT_PUBLIC_VESLO_APP_CONNECT_URL=
NEXT_PUBLIC_VESLO_AUTH_CALLBACK_URL=https://app.staging.veslo.work
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
LOOPS_API_KEY=
