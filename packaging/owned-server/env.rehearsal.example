# Copy to /srv/veslo/env/rehearsal.env on the owned server for rehearsal only.
# Replace these values before production. Do not reuse rehearsal values for live data.

# Reverse proxy and TLS are not used by the staging rehearsal commands unless
# the proxy service is explicitly started.
ACME_EMAIL=ops@veslo.work

# Isolated MySQL bootstrap values
DEN_DB_NAME=den
DEN_DB_USER=den
DEN_DB_PASSWORD=staging_den_db_password_change_me
DEN_DB_ROOT_PASSWORD=staging_den_root_password_change_me
AI_GATEWAY_DB_NAME=veslo_ai_gateway
AI_GATEWAY_DB_USER=gateway
AI_GATEWAY_DB_PASSWORD=staging_ai_gateway_db_password_change_me
AI_GATEWAY_DB_ROOT_PASSWORD=staging_ai_gateway_root_password_change_me

# Den staging
DATABASE_URL=mysql://den:staging_den_db_password_change_me@den-db:3306/den
BETTER_AUTH_SECRET=staging_only_better_auth_secret_32b__
BETTER_AUTH_URL=http://den:8788
WORKER_TOKEN_ENCRYPTION_KEY=staging_only_worker_token_key_32b__
GITHUB_CLIENT_ID=staging-github-client-id
GITHUB_CLIENT_SECRET=staging-github-client-secret
LETTR_API_KEY=
AUTH_EMAIL_ADDRESS=auth@veslo.work
AUTH_EMAIL_FROM_NAME=Veslo Staging
BACKUP_ALERT_EMAIL_RECIPIENTS=
BACKUP_DAILY_UTC_TIME=02:15:00
BACKUP_RANDOM_DELAY_SECONDS=900
CORS_ORIGINS=http://den:8788,http://ai-gateway:4034
DESKTOP_AUTH_REQUIRE_EMAIL_VERIFIED=false
PROVISIONER_MODE=stub
WORKER_URL_TEMPLATE=

# Keep external provisioning disabled during database rehearsal.
RENDER_API_BASE=https://api.render.com/v1
RENDER_API_KEY=
RENDER_OWNER_ID=
RENDER_WORKER_REPO=https://github.com/neatechcz/veslo
RENDER_WORKER_BRANCH=dev
RENDER_WORKER_ROOT_DIR=services/den-worker-runtime
RENDER_WORKER_PLAN=standard
RENDER_WORKER_REGION=oregon
RENDER_WORKER_VESLO_VERSION=0.11.113
RENDER_WORKER_NAME_PREFIX=den-worker-veslo-staging
RENDER_WORKER_PUBLIC_DOMAIN_SUFFIX=
RENDER_CUSTOM_DOMAIN_READY_TIMEOUT_MS=240000
RENDER_PROVISION_TIMEOUT_MS=900000
RENDER_HEALTHCHECK_TIMEOUT_MS=180000
RENDER_POLL_INTERVAL_MS=5000

# Keep worker vanity DNS integration disabled during database rehearsal.
VERCEL_API_BASE=https://api.vercel.com
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_TEAM_SLUG=
VERCEL_DNS_DOMAIN=

# Keep paid feature gates disabled during database rehearsal.
POLAR_FEATURE_GATE_ENABLED=false
POLAR_API_BASE=https://api.polar.sh
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
POLAR_BENEFIT_ID=
POLAR_SUCCESS_URL=
POLAR_RETURN_URL=

# Keep YouTrack projection disabled during database rehearsal.
YOUTRACK_PROJECT_KEY=VSLO
YOUTRACK_URL=
YOUTRACK_TOKEN=
YOUTRACK_TIMEOUT_MS=20000

# Debug-log ingest staging placeholders
DEN_LOG_INGEST_TOKEN=
DEN_LOG_MASTER_KEY=
DEN_LOG_MASTER_KEY_VERSION=
DEN_LOG_RETENTION_DAYS=30

# Den-managed AI staging placeholders
MANAGED_AI_DATABASE_URL=
MANAGED_AI_SECRET_KEY=
MANAGED_AI_OPENAI_CLIENT_ID=
MANAGED_AI_OPENAI_CLIENT_SECRET=
MANAGED_AI_OPENAI_REDIRECT_BASE=
MANAGED_AI_CODEX_COMMAND=codex
MANAGED_AI_CODEX_HOME=/var/lib/veslo-den/codex
MANAGED_AI_CODEX_ALLOW_HOST_HOME=
MANAGED_AI_CODEX_WORKDIR=/tmp
MANAGED_AI_CODEX_TIMEOUT_MS=180000
MANAGED_AI_CODEX_STATUS_TTL_MS=300000
MANAGED_AI_CODEX_AUTH_JSON=
MANAGED_AI_CODEX_OAUTH_INFERENCE_BASE_URL=
MANAGED_AI_CODEX_OAUTH_BASE_URL=

# Standalone AI Gateway staging
AI_GATEWAY_DATABASE_URL=mysql://gateway:staging_ai_gateway_db_password_change_me@ai-gateway-db:3306/veslo_ai_gateway
AI_GATEWAY_SECRET_KEY=staging_only_ai_gateway_secret_key_32b__
AI_GATEWAY_OPENAI_CLIENT_ID=staging-openai-client-id
AI_GATEWAY_OPENAI_CLIENT_SECRET=staging-openai-client-secret
AI_GATEWAY_OPENAI_REDIRECT_BASE=http://ai-gateway:4034/auth/openai
AI_GATEWAY_DEN_API_BASE=http://den:8788
AI_GATEWAY_ALERT_EMAIL_RECIPIENTS=
AI_GATEWAY_CODEX_CAPACITY_ALERT_EMAIL_INTERVAL_MS=300000
AI_GATEWAY_CODEX_COMMAND=codex
AI_GATEWAY_CODEX_HOME=/var/lib/veslo-ai-gateway/codex
AI_GATEWAY_CODEX_ALLOW_HOST_HOME=
AI_GATEWAY_CODEX_WORKDIR=/tmp
AI_GATEWAY_CODEX_TIMEOUT_MS=180000
AI_GATEWAY_CODEX_STATUS_TTL_MS=300000
AI_GATEWAY_CODEX_AUTH_JSON=
AI_GATEWAY_CODEX_OAUTH_INFERENCE_BASE_URL=
AI_GATEWAY_CODEX_OAUTH_BASE_URL=

# Web app staging placeholders. These are not used unless the web image is built.
DEN_API_BASE=http://den:8788
DEN_AUTH_ORIGIN=http://den:8788
NEXT_PUBLIC_OPENWORK_APP_CONNECT_URL=
NEXT_PUBLIC_OPENWORK_AUTH_CALLBACK_URL=http://localhost:3005
NEXT_PUBLIC_VESLO_APP_CONNECT_URL=
NEXT_PUBLIC_VESLO_AUTH_CALLBACK_URL=http://localhost:3005
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
LOOPS_API_KEY=
