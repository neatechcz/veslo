# Copy to /srv/veslo/env/production.env on the owned server and fill values there.
# Keep secrets out of git.

# Reverse proxy and TLS
ACME_EMAIL=ops@veslo.work

# MySQL container bootstrap values
DEN_DB_NAME=den
DEN_DB_USER=den
DEN_DB_PASSWORD=replace_with_den_db_password
DEN_DB_ROOT_PASSWORD=replace_with_den_root_password
AI_GATEWAY_DB_NAME=veslo_ai_gateway
AI_GATEWAY_DB_USER=gateway
AI_GATEWAY_DB_PASSWORD=replace_with_ai_gateway_db_password
AI_GATEWAY_DB_ROOT_PASSWORD=replace_with_ai_gateway_root_password

# Den
DATABASE_URL=mysql://den:replace_with_den_db_password@den-db:3306/den
BETTER_AUTH_SECRET=replace_with_32_char_den_auth_secret
BETTER_AUTH_URL=https://api.veslo.work
WORKER_TOKEN_ENCRYPTION_KEY=replace_with_worker_token_encryption_key
GITHUB_CLIENT_ID=replace_with_github_client_id
GITHUB_CLIENT_SECRET=replace_with_github_client_secret
LETTR_API_KEY=replace_with_lettr_api_key
AUTH_EMAIL_ADDRESS=auth@veslo.work
AUTH_EMAIL_FROM_NAME=Veslo
CORS_ORIGINS=https://app.veslo.work,https://ai.veslo.work
DESKTOP_AUTH_REQUIRE_EMAIL_VERIFIED=true
PROVISIONER_MODE=render
WORKER_URL_TEMPLATE=

# Temporary Render worker provisioning during the first cutover
RENDER_API_BASE=https://api.render.com/v1
RENDER_API_KEY=replace_with_render_api_key
RENDER_OWNER_ID=replace_with_render_owner_id
RENDER_WORKER_REPO=https://github.com/neatechcz/veslo
RENDER_WORKER_BRANCH=dev
RENDER_WORKER_ROOT_DIR=services/den-worker-runtime
RENDER_WORKER_PLAN=standard
RENDER_WORKER_REGION=oregon
RENDER_WORKER_VESLO_VERSION=0.11.113
RENDER_WORKER_NAME_PREFIX=den-worker-veslo
RENDER_WORKER_PUBLIC_DOMAIN_SUFFIX=
RENDER_CUSTOM_DOMAIN_READY_TIMEOUT_MS=240000
RENDER_PROVISION_TIMEOUT_MS=900000
RENDER_HEALTHCHECK_TIMEOUT_MS=180000
RENDER_POLL_INTERVAL_MS=5000

# Temporary Vercel DNS integration for worker vanity domains
VERCEL_API_BASE=https://api.vercel.com
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_TEAM_SLUG=
VERCEL_DNS_DOMAIN=

# Polar paywall
POLAR_FEATURE_GATE_ENABLED=false
POLAR_API_BASE=https://api.polar.sh
POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
POLAR_BENEFIT_ID=
POLAR_SUCCESS_URL=
POLAR_RETURN_URL=

# YouTrack feedback projection
YOUTRACK_PROJECT_KEY=VSLO
YOUTRACK_MCP_COMMAND=
YOUTRACK_MCP_ARGS=
YOUTRACK_MCP_TIMEOUT_MS=20000
YOUTRACK_MCP_WIRE_PROTOCOL=content-length
YOUTRACK_MCP_URL=
YOUTRACK_MCP_TOKEN=

# Den debug-log ingest
DEN_LOG_INGEST_TOKEN=
DEN_LOG_MASTER_KEY=
DEN_LOG_MASTER_KEY_VERSION=
DEN_LOG_RETENTION_DAYS=30

# Den-managed AI runtime, if Den owns managed-AI policy/assignment paths
MANAGED_AI_DATABASE_URL=
MANAGED_AI_SECRET_KEY=
MANAGED_AI_OPENAI_CLIENT_ID=
MANAGED_AI_OPENAI_CLIENT_SECRET=
MANAGED_AI_OPENAI_REDIRECT_BASE=
MANAGED_AI_CODEX_COMMAND=codex
MANAGED_AI_CODEX_HOME=/var/lib/veslo-den/codex
MANAGED_AI_CODEX_ALLOW_HOST_HOME=
MANAGED_AI_CODEX_WORKDIR=/tmp
MANAGED_AI_CODEX_TIMEOUT_MS=180000
MANAGED_AI_CODEX_STATUS_TTL_MS=300000
MANAGED_AI_CODEX_AUTH_JSON=
MANAGED_AI_CODEX_OAUTH_INFERENCE_BASE_URL=
MANAGED_AI_CODEX_OAUTH_BASE_URL=

# Standalone AI Gateway
AI_GATEWAY_DATABASE_URL=mysql://gateway:replace_with_ai_gateway_db_password@ai-gateway-db:3306/veslo_ai_gateway
AI_GATEWAY_SECRET_KEY=replace_with_32_char_ai_gateway_secret
AI_GATEWAY_OPENAI_CLIENT_ID=replace_with_openai_client_id
AI_GATEWAY_OPENAI_CLIENT_SECRET=replace_with_openai_client_secret
AI_GATEWAY_OPENAI_REDIRECT_BASE=https://ai.veslo.work/auth/openai
AI_GATEWAY_DEN_API_BASE=https://api.veslo.work
AI_GATEWAY_CODEX_COMMAND=codex
AI_GATEWAY_CODEX_HOME=/var/lib/veslo-ai-gateway/codex
AI_GATEWAY_CODEX_ALLOW_HOST_HOME=
AI_GATEWAY_CODEX_WORKDIR=/tmp
AI_GATEWAY_CODEX_TIMEOUT_MS=180000
AI_GATEWAY_CODEX_STATUS_TTL_MS=300000
AI_GATEWAY_CODEX_AUTH_JSON=
AI_GATEWAY_CODEX_OAUTH_INFERENCE_BASE_URL=
AI_GATEWAY_CODEX_OAUTH_BASE_URL=

# Web app
DEN_API_BASE=https://api.veslo.work
DEN_AUTH_ORIGIN=https://api.veslo.work
NEXT_PUBLIC_OPENWORK_APP_CONNECT_URL=
NEXT_PUBLIC_OPENWORK_AUTH_CALLBACK_URL=https://app.veslo.work
NEXT_PUBLIC_VESLO_APP_CONNECT_URL=
NEXT_PUBLIC_VESLO_AUTH_CALLBACK_URL=https://app.veslo.work
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
LOOPS_API_KEY=
