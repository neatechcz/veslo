pkgname=veslo
pkgver=2026.5.0
pkgrel=1 # pkgrel should change when PKGBUILD does. Standard is to change back to 1 next time. Any interger is valid.
pkgdesc="A local-first alternative to Claude Cowork"
arch=('x86_64' 'aarch64')
url="https://github.com/neatech/veslo"
license=('custom')
depends=('gtk3' 'glib2' 'libayatana-appindicator' 'libsoup3' 'webkit2gtk-4.1' 'openssl' 'dbus' 'librsvg')

# Architecture-specific sources and checksums
source_x86_64=("${pkgname}-${pkgver}.deb::${url}/releases/download/v${pkgver}/veslo-desktop-linux-amd64.deb")
sha256sums_x86_64=('281a4b5f35cffb5c78b6f68df397761a197abcfc73212b91b804c1a935fa41a1')

source_aarch64=("${pkgname}-${pkgver}.deb::${url}/releases/download/v${pkgver}/veslo-desktop-linux-arm64.deb")
sha256sums_aarch64=('6b8f796d002e73eaea9ab47c8831950dbb6877543f7bd60d8eed73fb8dec5aab')

# Makes sure makepkg doesn't extract the .deb since it will break
noextract=("${pkgname}-${pkgver}.deb")

package() {
  # cd cwd
  cd "${srcdir}"

  # Extract the internal data archive directly to the cwd.
  bsdtar -O -xf "${pkgname}-${pkgver}.deb" 'data.tar*' | bsdtar -C "${pkgdir}" -xf -
  rm -f "${pkgdir}/usr/bin/opencode"
}

# .deb Internal Structure Reference:
# └── veslo-desktop-linux-amd64.deb
#     ├── debian-binary
#     ├── control.tar.zst
#     └── data.tar.zst (Extracted to $pkgdir)
#         ├── opt/veslo/ (App files)
#         └── usr/bin/
#             ├── opencode (Terminal agent)
#             └── veslo (GUI launcher)
