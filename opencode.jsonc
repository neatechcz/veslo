{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "veslo",
  "mcp": {
    "control-chrome": {
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--isolated"
      ],
      "type": "local"
    }
  },
  "model": "codex_oauth/gpt-5.5",
  "plugin": [
    "opencode-scheduler"
  ],
  "provider": {
    "codex_oauth": {
      "name": "Veslo Codex OAuth",
      "npm": "@ai-sdk/openai-compatible",
      "env": [],
      "options": {
        "apiKey": "{env:VESLO_OPENCODE_SERVER_CLIENT_TOKEN}",
        "baseURL": "http://127.0.0.1:8787/ai-gateway/providers/codex_oauth/v1"
      },
      "models": {
        "gpt-5.5": {
          "name": "gpt-5.5",
          "tool_call": true,
          "reasoning": true,
          "headers": {
            "x-veslo-session-id": "${OPENCODE_SESSION_ID}"
          }
        }
      }
    }
  }
}
