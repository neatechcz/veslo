{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "veslo",
  "instructions": [
    ".opencode/soul-company.md",
    ".opencode/soul-user.md",
    ".opencode/soul-workspace.md"
  ],
  "mcp": {
    "control-chrome": {
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--isolated"
      ],
      "type": "local"
    }
  },
  "model": "codex_oauth/gpt-5.5",
  "provider": {
    "codex_oauth": {
      "env": [
        "VESLO_OPENCODE_SERVER_CLIENT_TOKEN"
      ],
      "models": {
        "gpt-5.5": {
          "name": "gpt-5.5",
          "tool_call": true,
          "reasoning": true,
          "options": {
            "reasoningEffort": "high",
            "reasoningSummary": "auto",
            "textVerbosity": "low"
          },
          "variants": {
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "textVerbosity": "low"
            },
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "low"
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "low"
            },
            "xhigh": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "textVerbosity": "low"
            }
          },
          "headers": {
            "x-veslo-session-id": "${OPENCODE_SESSION_ID}"
          }
        }
      },
      "name": "Veslo Codex OAuth",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8787/ai-gateway/providers/codex_oauth/v1",
        "headers": {},
        "apiKey": "{env:VESLO_OPENCODE_SERVER_CLIENT_TOKEN}"
      }
    }
  }
}
