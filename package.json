{
  "name": "@neatech/veslo-workspace",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm --filter @neatech/veslo dev",
    "dev:cleanup": "pnpm --filter @neatech/veslo dev:cleanup",
    "dev:ui": "pnpm --filter @neatech/veslo-ui dev",
    "dev:web": "bun scripts/dev-headless-web.ts",
    "dev:web:ui": "pnpm --filter @neatech/veslo-ui dev",
    "dev:headless-web": "bun scripts/dev-headless-web.ts",
    "build": "node scripts/build.mjs",
    "build:ui": "pnpm --filter @neatech/veslo-ui build",
    "build:desktop-ui": "node scripts/release/build-desktop-ui.mjs",
    "build:web": "pnpm --filter @neatech/veslo-ui build",
    "preview": "pnpm --filter @neatech/veslo-ui preview",
    "typecheck": "pnpm check:types",
    "lint": "eslint packages/app/src --max-warnings 0 && node --test scripts/lint-rule-contract.test.mjs",
    "check:lint": "pnpm lint",
    "check:typecheck-coverage": "node scripts/check-typecheck-coverage.mjs",
    "check:types": "pnpm check:typecheck-coverage && pnpm --filter @neatech/veslo-ui typecheck && pnpm --filter @neatech/veslo-e2e typecheck && pnpm --filter @neatech/veslo-landing typecheck && pnpm --filter @neatech/veslo-web typecheck && pnpm --filter veslo-code-router typecheck && pnpm --filter veslo-orchestrator typecheck && pnpm --filter veslo-server typecheck && pnpm --filter veslo-document-runtime typecheck && pnpm --filter @neatech/ai-gateway typecheck && pnpm --filter @neatech/den typecheck && pnpm --filter @neatech/worker-manager typecheck",
    "check:unit": "pnpm --filter @neatech/veslo-ui test:unit && pnpm --filter @neatech/veslo-ui test:reactivity && pnpm --filter @neatech/veslo-ui test:renderer-recovery && pnpm --filter veslo-server test && pnpm --filter veslo-orchestrator test:router && pnpm check:services && pnpm --filter veslo-code-router test:unit && pnpm --filter veslo-document-runtime test && pnpm --filter @neatech/ai-gateway test && pnpm --filter @neatech/den test && pnpm --filter @neatech/worker-manager test && pnpm --filter veslo-share-service test && node --test scripts/quality-workflow.test.mjs",
    "check:services": "pnpm --filter veslo-server build:bin && node --test scripts/headless-services.integration.test.mjs",
    "check:architecture": "pnpm audit:imports && pnpm audit:cycles && pnpm audit:routes && pnpm audit:veslo-headers && pnpm audit:session-identity",
    "check:rust": "cargo fmt --manifest-path packages/desktop/src-tauri/Cargo.toml --all -- --check && cargo clippy --manifest-path packages/desktop/src-tauri/Cargo.toml --all-targets --all-features --locked -- -D warnings && cargo test --manifest-path packages/desktop/src-tauri/Cargo.toml --all-features --locked",
    "check": "pnpm check:lint && pnpm check:types && pnpm check:unit && pnpm check:rust && pnpm check:architecture",
    "check:desktop-recovery": "pnpm --filter veslo-server build:bin && pnpm --filter @neatech/veslo run prepare:sidecar && pnpm --filter @neatech/veslo exec tauri build --debug --no-bundle --config src-tauri/tauri.e2e.conf.json -- --features e2e && pnpm --filter @neatech/veslo-e2e exec node --import=tsx/esm ./helpers/pilot-runner.ts --scenario vslo-235-local-host-child-exit",
    "test:health": "pnpm --filter @neatech/veslo-ui test:health",
    "test:sessions": "pnpm --filter @neatech/veslo-ui test:sessions",
    "test:refactor": "pnpm --filter @neatech/veslo-ui test:refactor",
    "test:events": "pnpm --filter @neatech/veslo-ui test:events",
    "test:todos": "pnpm --filter @neatech/veslo-ui test:todos",
    "test:permissions": "pnpm --filter @neatech/veslo-ui test:permissions",
    "test:session-switch": "pnpm --filter @neatech/veslo-ui test:session-switch",
    "test:fs-engine": "pnpm --filter @neatech/veslo-ui test:fs-engine",
    "test:e2e": "pnpm --filter @neatech/veslo-ui test:e2e",
    "test:e2e:ui": "pnpm --filter @neatech/veslo-e2e test",
    "test:e2e:ui:smoke": "pnpm --filter @neatech/veslo-e2e test:pilot:smoke",
    "desktop:smoke-packaged": "node scripts/desktop-smoke-packaged.mjs",
    "test:e2e:ui:navigation": "pnpm --filter @neatech/veslo-e2e test:pilot:navigation",
    "test:e2e:ui:live-inference": "pnpm --filter @neatech/veslo-e2e test:pilot:live-inference",
    "test:e2e:ui:soul-dashboard": "pnpm --filter @neatech/veslo-e2e test:pilot:soul-dashboard",
    "test:e2e:feedback-youtrack-live": "pnpm --filter @neatech/veslo-e2e test:pilot:feedback-youtrack-live",
    "test:e2e:ui:update-baselines": "pnpm --filter @neatech/veslo-e2e test:update-baselines",
    "test:orchestrator": "pnpm --filter veslo-orchestrator test:router",
    "audit:static": "pnpm audit:cycles && pnpm audit:veslo-headers && pnpm audit:knip",
    "audit:cycles": "node scripts/audit-cycles.mjs",
    "audit:knip": "knip --no-progress --dependencies --files --max-show-issues 80 --no-exit-code",
    "audit:knip:strict": "knip --no-progress --dependencies --files --max-show-issues 80",
    "audit:knip:exports": "node scripts/audit-unused-exports.mjs",
    "audit:knip:exports:strict": "node scripts/audit-unused-exports.mjs --strict",
    "audit:unused-exports": "pnpm audit:knip:exports",
    "audit:unused-exports:strict": "pnpm audit:knip:exports:strict",
    "audit:imports": "node scripts/audit-import-boundaries.mjs",
    "audit:routes": "node scripts/audit-route-contracts.mjs",
    "audit:headers": "node scripts/audit-header-inventory.mjs",
    "audit:headers:variants": "node scripts/audit-header-inventory.mjs --variants",
    "audit:veslo-headers": "node scripts/audit-veslo-headers.mjs",
    "audit:session-identity": "node scripts/audit-session-identity.mjs",
    "audit:fallbacks": "node scripts/audit-fallback-risks.mjs",
    "audit:client-logic": "node scripts/audit-client-logic.mjs",
    "audit:owners": "node scripts/audit-owner-hotspots.mjs",
    "audit:workflow-surfaces": "node scripts/audit-workflow-surfaces.mjs",
    "bump:calver": "pnpm --filter @neatech/veslo-ui bump:calver",
    "bump:patch": "pnpm --filter @neatech/veslo-ui bump:patch",
    "bump:minor": "pnpm --filter @neatech/veslo-ui bump:minor",
    "bump:major": "pnpm --filter @neatech/veslo-ui bump:major",
    "bump:set": "pnpm --filter @neatech/veslo-ui bump:set",
    "release:review": "node scripts/release/review.mjs",
    "release:prepare": "node scripts/release/prepare.mjs",
    "release:prepare:dry": "node scripts/release/prepare.mjs --dry-run",
    "release:ship": "node scripts/release/ship.mjs",
    "release:ship:watch": "node scripts/release/ship.mjs --watch",
    "release:prod": "node scripts/release/dispatch-production.mjs --push-tag --yes --watch",
    "release:prod:dry": "node scripts/release/dispatch-production.mjs --dry-run",
    "release:production": "node scripts/release/dispatch-production.mjs",
    "release:production:dry": "node scripts/release/dispatch-production.mjs --dry-run",
    "test:staging-app-build": "node scripts/release/staging-app-build.test.mjs",
    "tauri": "pnpm --filter @neatech/veslo exec tauri"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@whiskeysockets/baileys",
      "better-sqlite3",
      "edgedriver",
      "esbuild",
      "geckodriver",
      "protobufjs"
    ],
    "patchedDependencies": {
      "@solidjs/router@0.15.4": "patches/@solidjs__router@0.15.4.patch"
    }
  },
  "packageManager": "pnpm@10.27.0",
  "devDependencies": {
    "eslint": "9.39.3",
    "eslint-plugin-solid": "0.14.5",
    "knip": "^6.25.0",
    "madge": "8.0.0",
    "typescript-eslint": "8.64.0"
  }
}
