# Local Veslo runtime override.
VESLO_DISABLE_SANDBOX=1
VESLO_SHARED_OPENCODE_ENGINE=1

# Production SSH helper: `node scripts/admin/production-ssh.mjs --status`.
VESLO_PRODUCTION_SSH_HOST=62.109.146.43
VESLO_PRODUCTION_SSH_USER=neatech
VESLO_PRODUCTION_SSH_IDENTITY_FILE="your-ssh-key"
# Optional when the key is already loaded into ssh-agent. Never commit a real value.
VESLO_PRODUCTION_SSH_PASSPHRASE=
